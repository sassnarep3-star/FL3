{
  "meta": {
    "title": "Injury / availability ablation — chronological holdout (Week 10, 2026)",
    "brief_requirements": "R028, R029",
    "method": "Identical originated-line model run twice on the same Week 10 holdout. Ratings are calibrated on verified Weeks 1-9 only (chronological). Variant A applies the capped availability adjustment from the official Week 10 injury report; Variant B zeroes it. The two variants differ ONLY in the availability adjustment. Scored against verified Week 10 results. MAE/RMSE for spread and total; Brier for home win probability. 95% CIs are non-parametric bootstraps over the holdout games (seed 20261117, 20000 reps).",
    "inputs": {
      "results": {
        "src": "https://www.nfl.com/schedules/2026/REG10",
        "file": "data/week_results_2026.csv",
        "calibration_window": "Weeks 1-9",
        "holdout_window": "Week 10"
      },
      "availability": {
        "src": "https://www.nfl.com/injuries/",
        "file": "data/injuries_week10.json",
        "features": "injury-report game status (Out/Doubtful/Questionable) only"
      },
      "ratings": {
        "src": "https://www.nfl.com/standings/division/2026/REG",
        "note": "power ratings built from Weeks 1-9 cumulative standings"
      }
    },
    "exclusions": [
      "Depth-tier features are NOT modelled: the depth-tier source is unverified for most clubs (R042 BLOCKED), so the brief's gate forbids building that feature.",
      "No market price is used; no bet is recommended. Model output only.",
      "These are model-evaluation numbers, NOT leaderboard entries (the brief forbids backtest numbers on the leaderboard)."
    ],
    "limitations": [
      "Availability is captured for Week 10 only, so the head-to-head comparison is on the Week 10 holdout (n=12). The CIs are correspondingly wide.",
      "The holdout has 12 scored Week 10 games; the full 14-game slate is not yet fully scored in the results corpus."
    ]
  },
